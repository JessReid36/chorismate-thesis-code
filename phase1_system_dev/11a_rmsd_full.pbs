#!/bin/bash
#PBS -N cm11a_rmsdfull
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=12:00:00
#PBS -m ae
#PBS -M 18660916@sun.ac.za
#PBS -j oe
#PBS -o /home/18660916/system_development/05_qmmm/11a_rmsd_full.pbs.out
#
# 11a_rmsd_full.pbs - one backbone RMSD trace across the whole 60 ns run.
#
# The production trajectory is in two files which are one continuous run. Traces
# computed separately on each use different reference structures, so their
# absolute values cannot be compared and neither can be used for a figure or for
# any statement about total drift. This measures the whole run against frame 0 of
# the first file, and numbers the frames continuously from 0 to 59999, matching
# the frame manifest after renumbering.

set -uo pipefail
cd /home/18660916/system_development/05_qmmm || exit 1
echo "host=$(hostname) start=$(date)"; echo

[[ -s step11a_rmsd_full.sh ]] || { echo "FAIL missing step11a_rmsd_full.sh"; exit 1; }
grep -q "prod_ext.nc" step11a_rmsd_full.sh || { echo "FAIL script does not read the extension"; exit 1; }
grep -q "rmsd_vs_time_full.dat" step11a_rmsd_full.sh || { echo "FAIL script would overwrite an existing trace"; exit 1; }

bash step11a_rmsd_full.sh
rc=$?
echo; echo "step11a exit=$rc end=$(date)"
[[ $rc -eq 0 ]] || exit 1

out=/home/18660916/system_development/04_amber_md/11_analysis/rmsd_vs_time_full.dat
[[ -s "$out" ]] || { echo "FAIL no trace written"; exit 1; }
n=$(grep -vc '^#' "$out")
echo "frames written: $n"
[[ "$n" == "60000" ]] || echo "  NOTE expected 60000"
echo

python3 - "$out" <<'PY'
import sys, math
rows = [l.split() for l in open(sys.argv[1]) if not l.startswith("#")]
d = [float(r[2]) for r in rows]
n = len(d)
print("=" * 70)
print("Backbone RMSD across the whole run, one reference: %d frames" % n)
print("=" * 70)
print("\n5 ns blocks:")
for lo in range(0, n, 5000):
    b = d[lo:lo+5000]
    if len(b) < 2: continue
    m = sum(b)/len(b)
    s = math.sqrt(sum((x-m)**2 for x in b)/(len(b)-1))
    mark = "  <- pre-equilibration" if lo < 10000 else ""
    print("  %5d-%5d ps   mean %.3f   sd %.3f%s" % (lo, lo+len(b), m, s, mark))

eq = d[11000:]
m = sum(eq)/len(eq)
s = math.sqrt(sum((x-m)**2 for x in eq)/(len(eq)-1))
print("\nequilibrated portion, from 11000 ps: %d frames" % len(eq))
print("  mean %.3f   sd %.3f   min %.3f   max %.3f" % (m, s, min(eq), max(eq)))

var = sum((x-m)**2 for x in eq)/len(eq)
print("\nautocorrelation over the equilibrated portion:")
for lag in (15, 50, 100, 200, 300, 500, 800, 1000, 1500, 2000, 3000, 5000, 8000):
    if lag >= len(eq): break
    c = sum((eq[i]-m)*(eq[i+lag]-m) for i in range(len(eq)-lag))/((len(eq)-lag)*var)
    print("  lag %5d ps   C = %+.3f" % (lag, c))

tau = 0.0
for lag in range(1, min(len(eq)//4, 25000)):
    c = sum((eq[i]-m)*(eq[i+lag]-m) for i in range(len(eq)-lag))/((len(eq)-lag)*var)
    if c <= 0:
        break
    tau += c
print("\n  integrated to the first zero crossing: tau = %.0f ps" % tau)
print("  independent configurations in %d ps: %.1f" % (len(eq), len(eq)/(2*tau)))
print()
print("  Measured separately on the extension alone this was 699 ps and 35")
print("  configurations. A value from the whole equilibrated record supersedes")
print("  both that and the 806 ps estimated from 9 ns, which is what sized the")
print("  extension.")
PY
