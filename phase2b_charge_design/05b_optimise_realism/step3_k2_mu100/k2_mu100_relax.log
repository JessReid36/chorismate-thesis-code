   > mmcharges = [0.0]*24 + guan_q + guan_q          # two guanidiniums -> MM net +2
   > print(">> MM charge sum = %+.2f (net +2 = two +1 guanidiniums); QM subsystem stays -2" % sum(mmcharges))
   > 
   > LJ = {"C":(3.40,0.086),"N":(3.25,0.170),"O":(2.96,0.210),"H":(1.06,0.016)}
