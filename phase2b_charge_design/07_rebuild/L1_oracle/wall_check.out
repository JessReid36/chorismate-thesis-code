Input script: /home/18660916/07_rebuild/L1_oracle/wall_check.py
================================================================================
   > #!/usr/bin/env python3
   > """Does the LJ wall reach the QM substrate atom's gradient in the oracle's QM/MM setup?"""
   > import numpy as np
   > from ash import Fragment, ORCATheory, OpenMMTheory, QMMMTheory
   > import openmm
   > 
   > ORCADIR="/home/apps2/ORCA/6.0.1"
   > SIMPLE="! B3LYP D3BJ def2-SVP def2/J RIJCOSX CPCM TightSCF"
   > BLOCKS="%cpcm epsilon 4.0 end\n%scf MaxIter 300 Guess PModel end"
   > LJ={"C":(3.40,0.086)}
   > 
   > d=2.0
   > coords=f"C 0.0 0.0 0.0\nC {d} 0.0 0.0"
   > frag=Fragment(coordsstring=coords, charge=0, mult=1, conncalc=False)
   > mmcharges=[0.0, 1.0]
   > 
   > orca=ORCATheory(orcadir=ORCADIR, orcasimpleinput=SIMPLE, orcablocks=BLOCKS, numcores=4, autostart=False)
   > mm=OpenMMTheory(fragment=frag, dummysystem=True, platform="CPU", numcores=1, autoconstraints=None, rigidwater=False)
   > lj=openmm.CustomBondForce("4*eps*((sig/r)^12 - (sig/r)^6)")
   > lj.addPerBondParameter("sig"); lj.addPerBondParameter("eps"); lj.setUsesPeriodicBoundaryConditions(False)
   > ang=openmm.unit.angstrom; kcal=openmm.unit.kilocalorie_per_mole
   > si,ei=LJ["C"]
   > sig=((si+si)/2*ang).value_in_unit(openmm.unit.nanometer)
   > eps=(((ei*ei)**0.5)*kcal).value_in_unit(openmm.unit.kilojoule_per_mole)
   > lj.addBond(0,1,[sig,eps]); lj.setForceGroup(11); mm.system.addForce(lj)
   > 
   > qmmm=QMMMTheory(qm_theory=orca, mm_theory=mm, fragment=frag, qmatoms=[0],
   >                 charges=mmcharges, embedding="elstat", qm_charge=0, qm_mult=1, numcores=4)
   > res=qmmm.run(current_coords=frag.coords, Grad=True, charge=0, mult=1)
   > try:
   >     E,G=res
   > except (TypeError,ValueError):
   >     E=qmmm.energy; G=qmmm.grad
   > G=np.array(G)
   > fx=-G[0][0]
   > print("QM atom x=0, MM +1 site x=%.1f A (LJ min %.2f A)"%(d, 2**(1/6)*si))
   > print("force on QM atom along x = %+.4f Eh/Bohr"%fx)
   > print("  fx<0 => pushed AWAY: wall reaches QM (good)")
   > print("  fx>0 => pulled TOWARD: no wall on QM (collapse bug confirmed)")
